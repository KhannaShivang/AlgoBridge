{
  "manifest_version": 3,
  "name": "AlgoBridge - LeetCode to GitHub Sync",
  "version": "1.1.0",
  "description": "Automatically syncs your accepted LeetCode solutions and problem descriptions directly to your GitHub repository.",
  "permissions": [
    "storage",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*"
      ],
      "js": [
        "utils/languages.js",
        "utils/html-to-markdown.js",
        "scripts/leetcode-parser.js",
        "scripts/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AlgoBridge Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
